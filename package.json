{
  "name": "showmo",
  "version": "0.1.0",
  "description": "Show it when it matters — safe conditional visibility without eval.",
  "keywords": [
    "conditional",
    "visibility",
    "show-hide",
    "form",
    "dom",
    "vanilla-js",
    "no-eval"
  ],
  "homepage": "https://github.com/ernilambar/showmo#readme",
  "bugs": "https://github.com/ernilambar/showmo/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ernilambar/showmo.git"
  },
  "license": "MIT",
  "author": "Nilambar Sharma",
  "sideEffects": [
    "./src/showmo.css",
    "./src/iife.js"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.js",
    "./iife.js": "./dist/showmo.min.js",
    "./showmo.css": "./src/showmo.css",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "main": "./src/index.js",
  "module": "./src/index.js",
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "vite build && vite build --config vite.iife.config.js && cp src/showmo.css dist/showmo.css",
    "prepare": "npm run build",
    "lint": "standard",
    "lint:fix": "standard --fix",
    "test": "vitest run"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead"
  ],
  "devDependencies": {
    "browserslist-to-esbuild": "^2.1.1",
    "jsdom": "^30.0.1",
    "standard": "^17.1.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22"
  },
  "standard": {
    "envs": [
      "browser"
    ],
    "globals": [
      "afterEach",
      "beforeEach",
      "describe",
      "expect",
      "it"
    ]
  }
}
